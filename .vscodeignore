# Build inputs and tooling — the .vsix ships out/extension.js, not the sources.
src/**
scripts/**
esbuild.mjs
tsconfig*.json
vitest*.mts
.vscode/**
.github/**
.gitignore
.prettierrc.json
.prettierignore
eslint.config.mjs
lefthook.yml
CLAUDE.md
CONTRIBUTING.md
# Design notes for contributors. README.md and CHANGELOG.md do ship — they
# become the Marketplace's Overview and Changelog tabs — but nothing in docs/
# is written for someone who installed the extension.
docs/**
# The full lockup is source art and a README banner, not something the running
# extension ever loads. Shipping it would put 25 KB of unreferenced image in
# every install. GemDB_Icon.svg is the mark's vector source: resources/icon.png
# is rendered from it by scripts/render-icon.sh (regenerate it there, not by
# hand), and resources/gemdb-sidebar.svg is traced from it.
resources/GemDB.png
resources/GemDB_Icon.svg
**/*.map
**/*.ts
!out/**/*.js

# The Grail payload ships as-is: scripts/bundle-grail.sh already assembles only
# what the installer files into the database. These are belt-and-braces against
# a stale grail/ left behind by an older bundle.
grail/**/__pycache__/**
grail/**/*.o
grail/**/*.out
grail/.git/**

# The MCP payload ships as bundle-mcp.sh assembled it. Belt-and-braces against
# a stale mcp/ left behind by an older bundle, and against the two files the
# installer writes beside itself once it has run under the root path -- neither
# belongs in a published artifact, and .topazini is credentials.
mcp/**/*.out
mcp/.topazini
mcp/.git/**

# The extent the INTEGRATION SUITE starts from, and nothing else. GemDB stopped
# shipping a prepared extent deliberately -- a user's database accumulates their
# data, so an update has to install into whatever is already there (CLAUDE.md,
# "A release ships code to build a database, not a database"). This is 96 MB of
# test artifact that a user would download and never open, and shipping it would
# quietly restore the very thing that was removed. It is gitignored, so only a
# machine that has run `npm run test:extent` has one to leak -- which is every
# CI runner, since the integration job builds it before packaging.
.test-extent/**

# A build-time leftover from build-test-extent.sh: it names the scratch
# `gemdbbuild` stone, which does not exist on a user's machine. Our .tpz files set their own
# user/stone *after* any .topazini runs, so it cannot hijack a login — but a
# stray credentials file has no business in a published artifact.
grail/.topazini

# The same rule, applied to Grail's own development scripts. `bundle-grail.sh`
# copies `scripts/` wholesale — deliberately, because Grail decides what its
# source tree contains — and these three carry credentials while being no part
# of what GemDB installs. `topazini` is the same file as the one above under
# another name: a topaz init file logging in as DataCurator/swordfish against a
# stone called `gs64stone`, which does not exist on a user's machine. The other
# two set up Grail's own development users and worktrees.
#
# Nothing in GemDB reads any of them: `resources/install-grail.sh` writes its
# own `.topazini` and drives named scripts, and the only mentions anywhere in
# the payload are comments in `check_topazini_user.gs`. `check-vsix.sh` asserts
# all three stay out.
#
# Grail's install scripts DO carry `set user SystemUser pass swordfish`, and
# those stay: they are what the installer runs, the password is GemStone's
# published default for a fresh extent, and dropping them would break the
# install. The line drawn here is a credentials file that ships for no reason,
# not every appearance of the default password.
grail/scripts/topazini
grail/scripts/new_worktree.sh
grail/scripts/create_claude_users.gs

# koffi's own documentation and changelog — 100+ markdown files nothing reads.
node_modules/koffi/doc/**
node_modules/koffi/CHANGELOG.md
node_modules/koffi/README.md

# koffi ships a prebuilt binary for all 18 platforms it supports, ~25 MB of
# which a given build can never load. Its index.js is a `switch` over the
# detected `${platform}_${arch}` triplet with a static require per case, so only
# the matching file is ever touched and the absent ones cost nothing.
#
# Kept: the three platforms `isSupportedPlatform()` admits, ~4.3 MB in total.
# Ideally each per-target `.vsix` would carry only its own (1.2-1.6 MB), but
# `.vscodeignore` is one static file and vsce has no per-target ignore — so
# rather than generating this file per build, every target carries all three and
# wastes about 3 MB. That is a deliberate trade of a few megabytes for one
# fewer generated build input.
#
# This list is tied to `isSupportedPlatform()` in src/platform.ts and to the
# `package:*` targets in package.json. Adding a platform means adding its koffi
# binary here too, or the extension will load there and then fail to find its
# FFI module. `scripts/check-vsix.sh` asserts the target's own binary is
# present.
node_modules/koffi/build/koffi/**
!node_modules/koffi/build/koffi/darwin_arm64/**
!node_modules/koffi/build/koffi/linux_x64/**
!node_modules/koffi/build/koffi/linux_arm64/**
