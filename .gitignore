node_modules/
out/

# Python bytecode, from running the demo scripts under docs/demo/ with a
# plain CPython (which `underwriting.py` deliberately supports).
__pycache__/
*.pyc
*.vsix
*.tsbuildinfo
.DS_Store

# The bundled Grail payload is a build artifact of scripts/bundle-grail.sh, not
# source. It carries a compiled native library, so it is rebuilt per release
# rather than committed.
grail/

# The MCP server payload is a build artifact of scripts/bundle-mcp.sh. Unlike
# Grail's it carries nothing compiled, so it is the same on every platform --
# but it is still the mcp_server repository's code, not this one's.
mcp/

# The extent the integration suite starts from, built by
# scripts/build-test-extent.sh. A TEST artifact: no extent is shipped, because
# a user's database is theirs and Grail is installed into it.
.test-extent/

# The VS Code profile "Run GemDB (clean profile)" in .vscode/launch.json
# starts with. Delete it to start over as a new user.
.vscode-test/

# Release packages downloaded from CI by scripts/fetch-vsix.sh. Built
# elsewhere, published from here, kept nowhere.
dist/

# The extent the integration suite starts from, built by
# scripts/build-test-extent.sh. A TEST artifact: no extent is shipped.
.test-extent/
