node_modules/
out/
*.vsix
*.tsbuildinfo
.DS_Store

# The bundled Grail payload is a build artifact of scripts/bundle-grail.sh, not
# source. It carries a compiled native library, so it is rebuilt per release
# rather than committed.
grail/

# The MCP server payload is a build artifact of scripts/bundle-mcp.sh. Unlike
# Grail's it carries nothing compiled, so it is the same on every platform --
# but it is still the mcp_server repository's code, not this one's.
mcp/

# The preloaded extent is a build artifact of scripts/bundle-extent.sh.
extent/

# Release packages downloaded from CI by scripts/fetch-vsix.sh. Built
# elsewhere, published from here, kept nowhere.
dist/
